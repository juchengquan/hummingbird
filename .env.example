# Hummingbird has one backend: the Python agent service (services/agent-py/).
# The Next.js app is a frontend server with no secrets and no API routes
# (wave 13 of docs/PLAN-frontend-backend-split.md): it reads only the
# NEXT_PUBLIC_* variables and CSP_MODE in the first section below. Every
# other variable in this file is agent-py's (services/agent-py/README.md
# § Configuration). Both still read this one shared `.env` at the repo
# root; splitting it per app waits for wave 14 (the move to apps/web).

# ============================================================================
# Frontend (Next.js) — NEXT_PUBLIC_* values are built into the browser
# bundle, so never put a secret in one.
# ============================================================================

# Base URL of agent-py, the backend every surface talks to (chat on
# `/v1/runs`, tasks, schedules, files, MCP, the editor AI, …). Without it
# the app still builds, but shows a full-page "This deploy has no backend
# configured" screen pointing at the setup docs. Example:
# `http://localhost:8000` in dev — then also set
# CORS_ALLOWED_ORIGINS=http://localhost:3000 for agent-py (cross-origin).
# Same origin: set it to `/` when a reverse proxy serves agent-py on the
# frontend's own origin (PLAN-frontend-backend-split.md Q21) — requests
# go to `/v1/...` on the current origin and CSP needs no extra source.
# Local dev: `docker compose up proxy agent-py`, then open
# http://localhost:8080 (see README "Same-origin backend"). The CSP's
# report-uri / Reporting-Endpoints point at agent-py's `/v1/csp-report`
# (`/` → same-origin `/v1/csp-report`); unset → the policy has no report-uri.
NEXT_PUBLIC_AGENT_PY_URL=

# Optional. An extra backend origin the browser may call, added to the
# CSP's `connect-src`. Leave empty unless you know you need it.
NEXT_PUBLIC_API_BASE_URL=

# Supabase — optional. When set, users can sign in (email + password) and
# sync workspaces, conversations, files, and conversation assets across
# devices. When unset, the app runs anonymously on localStorage only.
# These are the public URL and anon key; agent-py reads its own
# SUPABASE_URL / SUPABASE_JWT_SECRET / SUPABASE_DB_URL below.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Content-Security-Policy mode (optional). `proxy.ts` mints a per-request
# nonce and emits a strict nonce + 'strict-dynamic' policy (built by
# lib/server/security/csp.ts); violations are POSTed to agent-py's
# /v1/csp-report and logged there as `{"evt":"csp_violation",…}` lines.
#   report-only (default) → Content-Security-Policy-Report-Only: nothing is
#                           blocked, violations are only reported
#   enforce               → Content-Security-Policy: violations are blocked
#   off                   → no CSP header at all (other security headers stay)
# Unset or unrecognised → report-only. Read docs/SECURITY.md before
# flipping to `enforce` (live-artifact / MCP-app frames inherit the policy).
CSP_MODE=

# ============================================================================
# agent-py (services/agent-py/) — every server secret and setting.
# Never expose any of these to the browser.
# ============================================================================

# Model registry and provider routing live in:
#   - config/models.json    (which models exist)
#   - config/providers.json (how to talk to each provider)
# Each provider entry in providers.json references its env vars by name
# (`apiKeyEnv`, `baseURLEnv`) — the vars below are the ones the default
# config references. agent-py serves each catalog model on its provider,
# all in the Anthropic Messages format (services/agent-py/README.md
# § Models and providers). With no provider configured, the model picker
# and the chat say so plainly, with a pointer to the setup docs — there is
# no mock answer.

# AI Gateway (Vercel) — the catalog's `gateway` routes (OpenAI, Google,
# DeepSeek; `anthropic/*` too when ANTHROPIC_API_KEY is unset).
AI_GATEWAY_API_KEY=

# Minimax-CN — optional. When BOTH vars are set, the `minimax/*` models
# are served through Minimax's Anthropic-compatible endpoint.
#
# IMPORTANT: include the `/v1` suffix in the base URL. The Anthropic SDK
# appends `/messages` only — it doesn't add `/v1`.
# Example: MINIMAX_CN_BASE_URL=https://api.minimax.chat/anthropic/v1
#
# The same key enables the `generateImage` tool (Minimax T2I / I2I via
# `/v1/image_generation`, derived from MINIMAX_CN_BASE_URL's origin;
# unset → `https://api.minimaxi.com`). Empty MINIMAX_CN_API_KEY → the
# tool is omitted.
MINIMAX_CN_BASE_URL=
MINIMAX_CN_API_KEY=

# Anthropic API key — `anthropic/*` models go to Anthropic directly with
# this key (each mapped to its `anthropicModelId`). Empty → those models
# go through the AI Gateway when it is configured, else a run on them
# fails with a message saying so (nothing falls back to canned output).
ANTHROPIC_API_KEY=

# Optional Anthropic base-URL override for the direct Anthropic route.
# Empty → Anthropic's own API (https://api.anthropic.com, passed
# explicitly). Has no effect when ANTHROPIC_API_KEY is empty.
ANTHROPIC_BASE_URL=

# Ollama — optional. When OLLAMA_BASE_URL is set, the `ollama/*` models are
# served by that Ollama host (Ollama ≥ 0.14, its Anthropic-format
# endpoint), and it is the fallback embedder when EMBEDDINGS_BASE_URL is
# unset. Typical local value: `http://localhost:11434/v1`. OLLAMA_API_KEY
# is optional (Ollama doesn't enforce auth). The `ollama` provider is
# declared with `allowInsecureBaseUrl: true` in providers.json, which lets
# a loopback / `http://` URL through — only enable this for endpoints you
# fully control.
OLLAMA_BASE_URL=
OLLAMA_API_KEY=

# OpenRouter — optional. When set, the `openrouter/*` models are served
# against `https://openrouter.ai/api/v1` (fixed in config/providers.json).
# Get a key from https://openrouter.ai/keys.
OPENROUTER_API_KEY=

# The default model: used when a request names none (/v1/summarize), for
# the follow-up-suggestion chips and for forced tool calls on a model
# without structured output. Must be a `config/models.json` id or the
# service refuses to boot. Empty → the default below.
AGENT_DEFAULT_MODEL=anthropic/claude-haiku-4.5

# Path to config/models.json (the model allowlist; providers.json beside
# it). Empty → searched upward from the package (finds the repo root in a
# checkout); the Docker image sets /app/config/models.json.
MODELS_CONFIG_PATH=

# Supabase project URL (the same value as NEXT_PUBLIC_SUPABASE_URL above).
# Reported by /readyz; the JWKS URL and Storage are derived from it.
SUPABASE_URL=

# Service role key — agent-py's Supabase Storage access (with
# SUPABASE_URL): generated images and tool-made files are saved
# under `user-files/<user_id>/generated/...` (the model then gets a
# long-lived signed URL instead of a short-lived one). Without it generated images fall back to inline
# Minimax URLs (work for hours, then expire). Share pages read through
# SUPABASE_DB_URL instead.
SUPABASE_SERVICE_ROLE_KEY=

# JWT secret — verifies HS256 access tokens. Find it under Project
# Settings → API → JWT Settings in the Supabase dashboard.
SUPABASE_JWT_SECRET=
# Optional. A project on Supabase's asymmetric signing keys issues ES256 /
# RS256 tokens; agent-py reads their public keys from
# <SUPABASE_URL>/auth/v1/.well-known/jwks.json, or from this URL when set.
# With neither the secret nor a JWKS URL, agent-py's auth endpoints return 503.
# SUPABASE_JWKS_URL=

# Optional. Required `aud` claim on user JWTs — tokens must also carry
# role=authenticated and a UUID `sub`, so the public anon key can't
# authenticate. Default `authenticated`.
# SUPABASE_JWT_AUDIENCE=authenticated

# Direct Postgres connection string. Required by the task worker, the
# scheduler, the reconciler and persisted runs, which need
# `FOR UPDATE SKIP LOCKED` semantics that the transaction pooler doesn't
# expose. Use the *direct* connection from Supabase's dashboard (the one
# ending in `db.<project>.supabase.co:5432`), NOT the pooler
# (`*.pooler.supabase.com:6543`). Empty in dev → the poller no-ops every
# tick (the service still serves /healthz + /readyz).
SUPABASE_DB_URL=

# Require sign-in for AI — optional, default off. When `true` (or `1`)
# AND Supabase is configured, anonymous runs and the anonymous calls that
# spend model budget answer `401 { code: "auth_required" }`, and
# /v1/extract skips its vision pass for anonymous callers (plain text
# extraction still works). Off / unset / no Supabase → anonymous mode
# works as before. Accepted values: true, false, 1, 0 (case-insensitive).
# Anything else is a configuration error: anonymous calls fail with 500
# until it's fixed (never silently open). The browser learns it from the
# 401, not from an env var.
REQUIRE_AUTH_FOR_AI=

# Optional. The schedule dispatcher. Unset, it follows the worker: on
# wherever WORKER_DRY_RUN=false and SUPABASE_DB_URL is set. `false` keeps
# it off, `true` forces it on. Safe on several replicas (each occurrence
# is claimed once). SCHEDULER_INTERVAL_SECONDS = seconds between ticks
# (default 60).
# SCHEDULER_ENABLED=
# SCHEDULER_INTERVAL_SECONDS=60

# Optional. The runs API (`/v1/runs`). REQUIRE_AUTH_FOR_AI above also
# refuses anonymous runs there (same strict values). Interactive runs hold
# a lease heartbeated every RUNS_HEARTBEAT_SECONDS (also how a cancel
# served by another replica reaches the run); a run whose lease lapses is
# failed by the reaper. Anonymous runs (and signed-in runs without
# SUPABASE_DB_URL) live in memory for RUNS_MEMORY_TTL_SECONDS after they end.
# Per client IP: RUNS_RATE_PER_MINUTE starts for everyone, plus the
# RUNS_ANONYMOUS_* limits for anonymous callers. RUNS_STUB_HARNESS=true
# runs every run on a model-free stub instead — for the contract
# conformance suite only.
# RUNS_LEASE_SECONDS=60
# RUNS_HEARTBEAT_SECONDS=5
# RUNS_REAPER_INTERVAL_SECONDS=15
# RUNS_MEMORY_TTL_SECONDS=900
# RUNS_MEMORY_MAX_RUNS=2000
# RUNS_RATE_PER_MINUTE=30
# RUNS_ANONYMOUS_RATE_PER_MINUTE=10
# RUNS_ANONYMOUS_DAILY_BUDGET=200
# RUNS_ANONYMOUS_MAX_CONCURRENT=3
# RUNS_STUB_HARNESS=false

# Optional. With SUPABASE_DB_URL, agent-py runs the no-worker reconciler:
# every RUNS_RECONCILE_INTERVAL_SECONDS it fails background tasks never
# picked up within TASK_NO_WORKER_TIMEOUT_MINUTES (below) while no worker
# ran anything. RUNS_RECONCILE_ENABLED=false turns it off.
# DB_POOL_MAX_SIZE = agent-py's Postgres connections (the worker, the
# scheduler, the reconciler and every runs request share them; default 10).
# RUNS_RECONCILE_ENABLED=true
# RUNS_RECONCILE_INTERVAL_SECONDS=60
# DB_POOL_MAX_SIZE=10

# Background-task safety net (agent-py's no-worker reconciler). agent-py
# executes every user's tasks unless an admin opts the user out
# (`auth.users.raw_app_meta_data->>'agent_backend'` set to anything but
# 'python'; their tasks fail up front). A task still `queued` and never
# started after this many minutes while NO worker executed anything in
# that window — agent-py's worker down or in WORKER_DRY_RUN — is failed
# with "No task worker available". A busy worker's backlog waits.
# Empty → 10.
TASK_NO_WORKER_TIMEOUT_MINUTES=

# Tests only. `true` runs background tasks on a model-free stub that
# answers canned text; empty / `false` is off, any other value fails the
# service at boot. Never set it in a deployment.
WORKER_STUB_MODEL=

# Rate-limit client-IP derivation. TRUSTED_PROXY_HOPS = number of reverse
# proxies in front of agent-py that append to X-Forwarded-For (default 1:
# one Caddy/Nginx); the client IP is the entry this many positions from
# the RIGHT (entries further left are client-supplied). `0` ignores XFF
# and keys on the socket peer. CLIENT_IP_HEADER = a platform header the
# edge overwrites with the real client IP (e.g. cf-connecting-ip); only
# set it if your edge really overwrites it. See docs/SECURITY.md.
# TRUSTED_PROXY_HOPS=1
# CLIENT_IP_HEADER=

# Optional. Exact browser origins allowed to call agent-py cross-origin,
# comma-separated — only needed when NEXT_PUBLIC_AGENT_PY_URL is an
# absolute URL on another origin (e.g. Next on :3000 calling agent-py on
# :8000; without this the browser's preflight fails). Leave empty with the
# same-origin proxy (NEXT_PUBLIC_AGENT_PY_URL=/). No wildcards;
# credentials are never allowed (the JWT is a bearer header).
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional. Upload cap for /v1/extract in bytes (default 5 MB).
# EXTRACT_MAX_BYTES=5242880

# Citation verifier model — optional. When set, a post-run citation pass
# runs on Deep Research reports: each cited claim is checked against its
# sources and the result shows a confidence chip + flagged claims (see
# docs/PLAN-citation-verifiability.md). Empty = OFF. Use a CHEAP model id
# (ideally cheaper/weaker than the answerer — cross-checking your own
# output is weaker). Uses the same ANTHROPIC_API_KEY / ANTHROPIC_BASE_URL
# client, so it's a no-op without a key regardless.
VERIFY_MODEL=

# Verifier provider family — optional. Default "anthropic" preserves the
# legacy same-family behaviour. Set to "google" to cross-check the answer
# with a different model family (a model is a weak judge of its own
# output). The Google path needs GOOGLE_API_KEY (or GEMINI_API_KEY) and the
# optional google-generativeai SDK; if either is missing it falls back to
# Anthropic with a one-shot log warning.
VERIFY_PROVIDER=anthropic

# Cross-family verifier key — used when VERIFY_PROVIDER=google. Either
# GOOGLE_API_KEY or GEMINI_API_KEY works (GOOGLE_API_KEY is checked first).
GOOGLE_API_KEY=

# Tavily — optional. Backs the `webSearch` tool. When unset the tool is
# omitted entirely, so the model never sees it.
TAVILY_API_KEY=

# Image generation rate limit. With MINIMAX_CN_API_KEY set, runs expose a
# `generateImage` tool (see Minimax-CN above). Each call costs ~1–3¢
# depending on aspect ratio + count, so the per-IP limit defaults tight.
# Raise for trusted deployments behind auth; lower if you're seeing
# abuse. Not a positive number → 5, floored, capped at 60.
MINIMAX_IMAGE_RATE_LIMIT_PER_MINUTE=5

# Optional. Per-IP cap on interactive runs' outbound tool calls per
# minute (webSearch + webFetch + searchFiles share one window). Default 20.
# WEB_TOOL_RATE_LIMIT_PER_MINUTE=20

# MCP encryption — required when any user picks Cloud-mode credentials
# for an MCP server. Generate with `openssl rand -base64 32`. The key
# lives only in agent-py's env, never in Postgres; it's passed as an
# argument to the SECURITY DEFINER encrypt/decrypt RPCs at request time.
# Rotating invalidates existing cloud-mode creds — users have to re-add
# the server. Leaving unset disables cloud mode (Local mode still works).
MCP_ENCRYPTION_KEY=

# MCP private-host opt-in — optional, default off. Every MCP server URL
# (local-mode proxy calls, cloud-mode rows, saves) is SSRF-checked and
# must resolve to a public address. Set to `true` to also allow
# loopback / RFC 1918 / `.local`-style hosts — e.g. an MCP server on
# `http://localhost:3001/mcp` during single-user local dev. Link-local
# and cloud-metadata addresses (169.254.169.254 etc.) stay blocked even
# then. Do NOT enable on a shared/hosted deployment: any user could then
# point the server at your internal network. Only `true` enables it; a
# value other than `true` / `false` / empty stops agent-py at boot.
MCP_ALLOW_PRIVATE_HOSTS=

# Embeddings — optional. Enables the vector / hybrid-retrieval pipeline
# (chunk + embed file text → pgvector, served by /v1/embed). Without it,
# retrieval stays full-text only. Points at an OpenAI-compatible
# `/v1/embeddings` endpoint; Ollama works (set EMBEDDINGS_BASE_URL to the
# same `/v1` URL, or leave blank to reuse OLLAMA_BASE_URL above).
# EMBEDDINGS_MODEL defaults to `nomic-embed-text` (768-dim — must match
# the vector(768) column in migration 0023).
EMBEDDINGS_BASE_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=

# Memory-extraction model — optional. Distils durable facts from a
# finished chat turn when the user has memory on (/v1/memory/extract).
# Used when it is a `supportsStructuredOutput` model a provider serves;
# otherwise (or empty) AGENT_DEFAULT_MODEL.
MEMORY_EXTRACT_MODEL=

# Code interpreter sandbox (optional). Set CODE_SANDBOX_ENABLED=1 to register
# the `runCode` skill and execute model-written Python/JS in a local
# microsandbox microVM (libkrun; HVF on Apple Silicon). Network is OFF inside
# the sandbox; pandas/numpy/matplotlib available (see image note below).
# Absent → the skill is simply not registered (no mock). CODE_SANDBOX_BASE_URL
# also enables it and is reserved for a future remote backend (the local
# microVM runtime ignores the URL). Needs `uv sync --extra sandbox`
# (services/agent-py/README.md § Code interpreter); see also
# docs/PLAN-execution-sandbox.md + docs/PLAN-code-interpreter.md.
CODE_SANDBOX_ENABLED=
CODE_SANDBOX_BASE_URL=
# Optional overrides: CODE_SANDBOX_TIMEOUT_MS (30000), CODE_SANDBOX_STDOUT_CAP
# (256000), CODE_SANDBOX_RESULT_CAP (10000000), CODE_SANDBOX_RESULT_FILE_MAX (20),
# CODE_SANDBOX_MEM_MIB (512),
# CODE_SANDBOX_CPUS (1), CODE_SANDBOX_MAX_CONCURRENT (2). The Python image must
# already contain the scientific
# stack (airgapped → no pip at run time); the default jupyter/scipy-notebook is
# large — build docker/runcode-python.Dockerfile (~550 MB), push it, and set
# CODE_SANDBOX_PYTHON_IMAGE to that image to trim it (and CODE_SANDBOX_JS_IMAGE,
# default "node", for JavaScript).
# Give agent-py its own, SHORT microsandbox home — socket paths derive from
# it (< 104 bytes):
# MSB_HOME=~/.msb-py

# Vision document extraction (optional). Picks the vision-capable model
# /v1/extract uses to transcribe layout-rich / scanned PDFs (render pages →
# image → markdown tables/captions) on top of the text-only pass. Must name
# a model flagged `supportsVision` in config/models.json and served here.
# Unset → the first such model; if none, the vision pass is skipped
# (text-only extraction). See docs/PLAN-multimodal-docs.md. Example:
# `anthropic/claude-sonnet-4.6`.
VISION_MODEL=
