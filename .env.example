# AI Gateway (Vercel) — required for real chat & editor AI.
# When unset, the chat panel falls back to a clearly-labeled mock response.
AI_GATEWAY_API_KEY=

# Supabase — optional. When set, users can sign in (magic link) and sync
# workspaces, conversations, files, and conversation assets across devices.
# When unset, the app runs anonymously on localStorage only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-side only. Required for share links so the
# public `/share/...` pages can read the shared conversation/document via
# the admin client (bypasses RLS, scoped to the token-matched row only).
# Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Tavily — optional. Backs the Web Search skill. When unset, the skill
# toggle still appears in the UI but the chat route omits the tool and
# tells the model so it falls back to its training data instead of
# inventing a search call.
TAVILY_API_KEY=

# MCP encryption — required when any user picks Cloud-mode credentials
# for an MCP server. Generate with `openssl rand -base64 32`. The key
# lives only in the Next.js server env, never in Postgres; it's passed
# as an argument to the SECURITY DEFINER decrypt RPC at request time.
# Rotating invalidates existing cloud-mode creds — users have to re-add
# the server. Leaving unset disables cloud mode (Local mode still works).
MCP_ENCRYPTION_KEY=

# Optional. Base URL for the backend API surface. Empty (default) means
# same-origin: the Next.js routes under app/api/* serve everything.
# Setting this to e.g. "https://api.example.com" makes lib/api-client.ts
# point at that host instead — used when the backend is rewritten in
# another language (see docs/PLAN-backend-extraction.md). NEXT_PUBLIC_*
# because the value is read in the browser.
NEXT_PUBLIC_API_BASE_URL=
