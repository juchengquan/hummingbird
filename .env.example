# Model registry and provider routing live in:
#   - config/models.json    (which models exist; safe for client bundling)
#   - config/providers.json (how to talk to each provider; server-only,
#                            supports inline `apiKey` / `baseURL` overrides
#                            so users can paste credentials directly there
#                            instead of using these env vars if preferred)
# Each provider entry in providers.json can reference an env var by name
# (`apiKeyEnv`, `baseURLEnv`) — the vars listed below are the ones the
# default config references. Three provider `type`s are supported:
#
#   - "gateway"   → Vercel AI Gateway (apiKey only)
#   - "anthropic" → any Anthropic-compatible endpoint (baseURL + apiKey)
#   - "openai"    → any OpenAI-compatible endpoint (baseURL + apiKey),
#                   works with OpenRouter / Together / Groq / vLLM /
#                   LM Studio / Ollama / self-hosted gateways
#
# Adding a new model is a two-file edit (provider entry + model entry);
# see config/providers.json and lib/server/providers-config.ts for the
# full schema.

# AI Gateway (Vercel) — referenced by the `gateway` provider in
# config/providers.json. Required for real chat & editor AI on the
# default model set. When unset, the chat panel falls back to a clearly
# labeled mock response.
AI_GATEWAY_API_KEY=

# Trusted reverse-proxy hops — how many proxies in front of Next.js each
# append the peer address to `X-Forwarded-For`. The per-IP rate limiter
# (and the anonymous summarize-cache scope) reads the client IP from the
# entry this many positions from the RIGHT; entries further left are
# client-supplied and ignored. Default 1 (one Caddy/Nginx on the
# self-hosted VM, or Vercel's edge). Set 2 for e.g. Cloudflare → Caddy →
# Next. On Vercel (`VERCEL` set) the platform's `x-real-ip` header is
# used first. services/agent-ts reads the same var with the same
# semantics.
#
# A REVERSE PROXY IS REQUIRED FOR PER-IP LIMITS. Route handlers never
# see the socket peer, and `next start` only sets X-Forwarded-For
# when the request has none — so with Next exposed directly, a client
# that sends its own X-Forwarded-For picks its own rate-limit key. `0`
# does NOT fall back to the socket peer in Next.js (that's agent-py
# only, below): XFF is ignored and ALL anonymous traffic shares one
# bucket. `next start` logs a warning at boot when this is unset (or 0)
# outside a known platform; setting it explicitly confirms your proxy
# setup.
# TRUSTED_PROXY_HOPS=1

# Minimax-CN — referenced by the `minimax-cn` provider in
# config/providers.json. Optional. When BOTH vars are set, the
# `minimax/*` model entries in config/models.json route via the native
# Anthropic provider (Minimax-CN's Anthropic-compatible API) instead of
# going through the Vercel AI Gateway. Either var unset → minimax/*
# falls back to the gateway as declared by the model's `routes` list.
#
# IMPORTANT: include the `/v1` suffix in the base URL. The Anthropic SDK
# appends `/messages` only — it doesn't add `/v1`. So set this to the
# endpoint that, when `/messages` is appended, matches Minimax-CN's
# Anthropic-compatible POST endpoint.
# Example: MINIMAX_CN_BASE_URL=https://api.minimax.chat/anthropic/v1
#
# Both vars are ALSO read by the Python agent service (services/agent-py/)
# from Phase 3d-1+ to enable the `generateImage` tool (Minimax T2I / I2I
# via `/v1/image_generation`, derived from MINIMAX_CN_BASE_URL's origin).
# Empty MINIMAX_CN_API_KEY → the tool is omitted from the registry.
MINIMAX_CN_BASE_URL=
MINIMAX_CN_API_KEY=

# Supabase — optional. When set, users can sign in (magic link) and sync
# workspaces, conversations, files, and conversation assets across devices.
# When unset, the app runs anonymously on localStorage only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Require sign-in for AI — optional, default off. When `true` (or `1`)
# AND Supabase is configured above, the routes that spend model budget
# (/api/chat, /api/summarize, /api/ai/command, /api/ai/complete,
# /api/extract-table, /api/memory/extract) answer anonymous callers with
# `401 { code: "auth_required" }`, and /api/extract skips its vision pass
# for them (plain text extraction still works). The session is verified
# server-side with Supabase `getUser()`. Off / unset / no Supabase →
# anonymous mode works exactly as before. Accepted values: true, false,
# 1, 0 (case-insensitive). Anything else is a configuration error: the
# gated routes fail with 500 until it's fixed (never silently open).
# Server-only — the browser learns it from the 401, not from an env var.
REQUIRE_AUTH_FOR_AI=

# Service role key — server-side only. Required for share links so the
# public `/share/...` pages can read the shared conversation/document via
# the admin client (bypasses RLS, scoped to the token-matched row only).
# ALSO read by the Python agent service from Phase 3d-2+ for the
# `generateImage` Storage-persistence path: when SUPABASE_URL +
# SUPABASE_SERVICE_ROLE_KEY are both set, generated images get mirrored
# into `user-files/<user_id>/generated/...` and the model receives a
# long-lived signed URL instead of the short-lived Minimax URL. Without
# them the tool falls back to inline Minimax URLs (work for hours, then
# expire). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# JWT secret — server-side only. Required by the Python agent service
# (services/agent-py/) for any auth-protected endpoint; without it those
# endpoints return 503. Find it under Project Settings → API → JWT Settings
# in the Supabase dashboard. The Next.js side doesn't use this directly
# (it reads the Supabase session cookie); only the Python service does.
SUPABASE_JWT_SECRET=

# Optional. Shared secret for the scheduled-task cron route
# (`/api/tasks/jobs/tick`, wired in vercel.json). Unset → the route is
# disabled (503). Callers must send `Authorization: Bearer <CRON_SECRET>`
# — Vercel Cron does this automatically when the project has CRON_SECRET
# set. A `?secret=` query parameter is NOT accepted (it would leak into
# access logs). Generate with `openssl rand -base64 32`.
# CRON_SECRET=

# Optional (agent-py). Run the schedule dispatcher inside agent-py — the
# replacement for the Vercel Cron above. Off by default; needs
# SUPABASE_DB_URL. Safe to enable while the Vercel Cron still runs (each
# occurrence is claimed once); remove the cron from vercel.json after.
# SCHEDULER_INTERVAL_SECONDS = seconds between ticks (default 60).
# SCHEDULER_ENABLED=false
# SCHEDULER_INTERVAL_SECONDS=60

# Optional (agent-py). The runs API (`/v1/runs`). REQUIRE_AUTH_FOR_AI above
# also refuses anonymous runs there (same strict values). Interactive runs
# hold a lease heartbeated every RUNS_HEARTBEAT_SECONDS (also how a cancel
# served by another replica reaches the run); a run whose lease lapses is
# failed by the reaper. Anonymous runs (and signed-in runs without
# SUPABASE_DB_URL) live in memory for RUNS_MEMORY_TTL_SECONDS after they end.
# Per client IP: RUNS_RATE_PER_MINUTE starts for everyone, plus the
# RUNS_ANONYMOUS_* limits for anonymous callers. RUNS_STUB_HARNESS=true runs
# every run on a model-free stub — for the contract conformance suite only.
# RUNS_LEASE_SECONDS=60
# RUNS_HEARTBEAT_SECONDS=5
# RUNS_REAPER_INTERVAL_SECONDS=15
# RUNS_MEMORY_TTL_SECONDS=900
# RUNS_MEMORY_MAX_RUNS=2000
# RUNS_RATE_PER_MINUTE=30
# RUNS_ANONYMOUS_RATE_PER_MINUTE=10
# RUNS_ANONYMOUS_DAILY_BUDGET=200
# RUNS_ANONYMOUS_MAX_CONCURRENT=3
# RUNS_STUB_HARNESS=false

# Optional (agent-py + agent-ts). Required `aud` claim on user JWTs —
# tokens must also carry role=authenticated and a UUID `sub`, so the
# public anon key can't authenticate. Default `authenticated`.
# SUPABASE_JWT_AUDIENCE=authenticated

# Optional (agent-py). Rate-limit client-IP derivation. TRUSTED_PROXY_HOPS
# = number of reverse proxies that append to X-Forwarded-For (default 1;
# 0 = ignore XFF and use the socket peer — agent-py ONLY; Next.js and
# agent-ts don't read the socket peer, so there 0 means one shared bucket,
# see the TRUSTED_PROXY_HOPS note at the top). CLIENT_IP_HEADER = a platform header
# the edge overwrites with the real client IP (e.g. cf-connecting-ip);
# only set it if your edge really overwrites it.
# TRUSTED_PROXY_HOPS=1
# CLIENT_IP_HEADER=

# Optional (agent-py). Exact browser origins allowed to call agent-py
# cross-origin, comma-separated — only needed when NEXT_PUBLIC_AGENT_PY_URL
# is an absolute URL on another origin (e.g. Next on :3000 calling
# agent-py on :8000; without this the browser's preflight fails). Leave
# empty with the same-origin proxy (NEXT_PUBLIC_AGENT_PY_URL=/). No
# wildcards; credentials are never allowed (the JWT is a bearer header).
# CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional (agent-py). Upload cap for /v1/extract in bytes (default 5 MB,
# matching the Next.js /api/extract FILE_SIZE_LIMIT).
# EXTRACT_MAX_BYTES=5242880

# Direct Postgres connection string — server-side only. Required by the
# Python agent service's Phase 1+ poll loop (services/agent-py/poller.py)
# which needs `FOR UPDATE SKIP LOCKED` semantics that the transaction
# pooler doesn't expose. Use the *direct* connection from Supabase's
# dashboard (the one ending in `db.<project>.supabase.co:5432`), NOT the
# pooler (`*.pooler.supabase.com:6543`). Empty in dev → poller no-ops
# every tick (the service still serves /healthz + /readyz).
SUPABASE_DB_URL=

# Anthropic API key — read by the Python agent service (Phase 2b-1+).
# When set, the executor uses the real `messages.stream` against
# Anthropic for any `start` job on a flagged user. Empty → the
# executor falls back to the Phase 2a stub step fn (two canned tokens),
# so the service stays runnable in dev without a live key. The Next.js
# side talks to Anthropic via the Vercel AI Gateway today and doesn't
# read this directly.
ANTHROPIC_API_KEY=

# Optional Anthropic base-URL override. Empty → SDK default
# (https://api.anthropic.com). Set to point the Python service's
# `AsyncAnthropic` client at any Anthropic-compatible endpoint:
#   - a proxy or self-hosted gateway,
#   - a region-specific upstream (Minimax's `/anthropic/v1` host, etc.),
#   - a local model serving the Anthropic messages API.
# Mirrors the TS side's `MINIMAX_CN_BASE_URL` override pattern. Has no
# effect when `ANTHROPIC_API_KEY` is empty (the stub doesn't network).
ANTHROPIC_BASE_URL=

# Agent services' default model (agent-py + agent-ts). Both services
# accept ONLY the `anthropic/*` entries of config/models.json (each
# mapped to its `anthropicModelId`); any other model id → 400
# `unknown_model`. This catalog id is used when a request names none
# (/v1/summarize) and for follow-up-suggestion chips. It must be on that
# allowlist or the service refuses to boot. Empty → the default below.
AGENT_DEFAULT_MODEL=anthropic/claude-haiku-4.5

# Background-task safety net (Next.js stale-run reconciler). agent-py
# executes every user's tasks unless an admin opts the user out
# (`auth.users.raw_app_meta_data->>'agent_backend'` set to anything but
# 'python'; their tasks fail up front). A task still `queued` and never
# started after this many minutes while NO worker executed anything in
# that window — agent-py down or in WORKER_DRY_RUN — is failed with
# "No task worker available". A busy worker's backlog waits. Empty → 10.
TASK_NO_WORKER_TIMEOUT_MINUTES=

# agent-py only — path to config/models.json (the model allowlist).
# Empty → searched upward from the package (finds the repo root in a
# checkout); the Docker image sets /app/config/models.json.
MODELS_CONFIG_PATH=

# Citation verifier model — optional. When set, the Python agent service
# runs a post-run citation pass on Deep Research reports: each cited claim
# is checked against its sources and the result shows a confidence chip +
# flagged claims (see docs/PLAN-citation-verifiability.md). Empty = OFF.
# Use a CHEAP model id (ideally cheaper/weaker than the answerer — cross-
# checking your own output is weaker). Uses the same ANTHROPIC_API_KEY /
# ANTHROPIC_BASE_URL client, so it's a no-op without a key regardless.
VERIFY_MODEL=

# Verifier provider family — optional. Default "anthropic" preserves the
# legacy same-family behaviour. Set to "google" to cross-check the answer
# with a different model family (a model is a weak judge of its own
# output). The Google path needs GOOGLE_API_KEY (or GEMINI_API_KEY) and the
# optional google-generativeai SDK; if either is missing it falls back to
# Anthropic with a one-shot log warning.
VERIFY_PROVIDER=anthropic

# Cross-family verifier key — used when VERIFY_PROVIDER=google. Either
# GOOGLE_API_KEY or GEMINI_API_KEY works (GOOGLE_API_KEY is checked first).
GOOGLE_API_KEY=

# Tavily — optional. Backs the "Web search (Tavily)" skill on the
# Next.js chat route AND the Python agent service's `webSearch` tool
# (Phase 3c of PLAN-agent-api). When unset:
#   - Next.js side: the skill toggle still appears in the UI but the
#     chat route omits the tool and tells the model so it falls back
#     to training data instead of inventing a search call.
#   - Python service: the `webSearch` tool is omitted entirely from
#     `default_tool_registry()`, so the model never sees it.
TAVILY_API_KEY=

# Brave Search — optional. Backs the "Web search (Brave)" skill. Same
# fallback behaviour as Tavily when unset. Independent web index — tends
# to surface fresher, less SEO-spammed results. Get a key from
# https://api-dashboard.search.brave.com (a "Data for Search" plan is
# enough for chat usage). Both providers can be enabled at the same time;
# the model picks whichever it prefers per query and the shared per-turn
# cap (configurable in the right rail) applies across both.
BRAVE_SEARCH_API_KEY=

# Exa — optional. Backs the "Web search (Exa)" provider. Exa runs an
# embedding-based ("neural") web index that tends to surface higher-
# quality, link-target-style pages than keyword engines, plus an "auto"
# mode that picks neural vs keyword per query. Same fallback behaviour
# as Tavily/Brave when unset. Get a key from https://dashboard.exa.ai.
# All three providers can be enabled at once; results are deduped by
# URL and interleaved server-side, and one `webSearch` tool call counts
# as one cap unit regardless of how many providers it fans out to.
EXA_API_KEY=

# Image generation — optional. When MINIMAX_CN_API_KEY above is set,
# the chat route exposes a `generateImage` tool that calls Minimax's
# documented `/v1/image_generation` endpoint. The endpoint host is
# derived from MINIMAX_CN_BASE_URL's origin (image and chat share a
# host on Minimax — chat lives at `/anthropic/v1/messages`, image at
# `/v1/image_generation`). When MINIMAX_CN_BASE_URL is unset, the
# client falls back to the default `https://api.minimaxi.com`
# endpoint. Supports text-to-image and image-to-image (when the model
# includes a `referenceImageUrl`). Each call costs ~1–3¢ depending on
# aspect ratio + count, so the per-IP rate limit below defaults tight.
# Raise for trusted deployments behind auth; lower if you're seeing
# abuse.
MINIMAX_IMAGE_RATE_LIMIT_PER_MINUTE=5

# MCP encryption — required when any user picks Cloud-mode credentials
# for an MCP server. Generate with `openssl rand -base64 32`. The key
# lives only in the Next.js server env (AND the Python agent service env
# from Phase 3f-1+, which reads the same var to call the same SECURITY
# DEFINER decrypt RPC), never in Postgres; it's passed as an argument
# to the RPC at request time. Rotating invalidates existing cloud-mode
# creds — users have to re-add the server. Leaving unset disables cloud
# mode on both stacks (Local mode still works).
MCP_ENCRYPTION_KEY=

# MCP private-host opt-in — optional, default off. Every MCP server URL
# (local-mode request bodies, cloud-mode rows, saves) is SSRF-checked
# and must resolve to a public address. Set to `true` to also allow
# loopback / RFC 1918 / `.local`-style hosts — e.g. an MCP server on
# `http://localhost:3001/mcp` during single-user local dev. Link-local
# and cloud-metadata addresses (169.254.169.254 etc.) stay blocked even
# then. Do NOT enable on a shared/hosted deployment: any user could then
# point the server at your internal network. Honoured by Next.js and
# services/agent-ts alike.
MCP_ALLOW_PRIVATE_HOSTS=

# Ollama — optional. When OLLAMA_BASE_URL is set, the `ollama` provider
# in config/providers.json activates, and any model whose route uses
# `via: "ollama"` (e.g. `ollama/llama3.1:8b`, `ollama/qwen3:8b`) is
# dispatched against an OpenAI-compatible client pointed at this base
# URL. Typical local value: `http://localhost:11434/v1` (note the `/v1`
# suffix — Ollama's docs call this the "OpenAI compatibility" endpoint).
#
# OLLAMA_API_KEY is optional and usually empty — Ollama doesn't enforce
# auth on its OpenAI-compat endpoint. The `ollama` provider is declared
# with `allowInsecureBaseUrl: true` in providers.json, which (a) lets
# the SSRF gate accept loopback / `http://` URLs and (b) lets the route
# resolve without an API key. Only enable this for endpoints you fully
# control — by enabling it you accept that the URL is trusted not to
# exfiltrate any header the AI SDK may attach.
OLLAMA_BASE_URL=
OLLAMA_API_KEY=

# Embeddings — optional. Enables the vector / hybrid-retrieval pipeline
# (chunk + embed file text → pgvector). Without it, retrieval stays
# full-text only (nothing changes). Points at an OpenAI-compatible
# `/v1/embeddings` endpoint; Ollama works (set EMBEDDINGS_BASE_URL to the
# same `/v1` URL, or leave blank to reuse OLLAMA_BASE_URL above).
# EMBEDDINGS_MODEL defaults to `nomic-embed-text` (768-dim — must match
# the vector(768) column in migration 0023). See lib/server/embeddings/.
# Also read by the Python agent service (services/agent-py/), which
# serves /v1/embed for agent-py accounts with the same precedence
# (EMBEDDINGS_* first, then OLLAMA_BASE_URL / OLLAMA_API_KEY above).
EMBEDDINGS_BASE_URL=
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=

# Memory-extraction model — optional. Distils durable facts from a
# finished chat turn when the user has memory on. Next.js: any model id
# (default `google/gemini-2.5-flash`). The Python agent service
# (/v1/memory/extract, agent-py accounts) uses it only when it is an
# allowed `anthropic/*` entry of config/models.json; otherwise (or
# empty) AGENT_DEFAULT_MODEL.
MEMORY_EXTRACT_MODEL=

# OpenRouter — optional. When OPENROUTER_API_KEY is set, the
# `openrouter` provider in config/providers.json activates and any
# model whose route uses `via: "openrouter"` is dispatched against the
# `https://openrouter.ai/api/v1` OpenAI-compatible endpoint.
#
# Get a key from https://openrouter.ai/keys. Two notable model entries
# in the default `config/models.json`:
#   - `openrouter/auto` — OpenRouter picks the model per request based
#     on prompt length, latency budget, and price. Lets you keep one
#     model id in the UI while OpenRouter does the routing.
#   - `openrouter/anthropic/claude-sonnet-4.5` (and similar) — a
#     specific upstream model via OpenRouter's catalogue.
#
# Per-route fallback list: each non-`auto` OpenRouter entry in
# `config/models.json` declares a `fallbacks: [...]` array of upstream
# model ids. The Next.js dispatcher injects this list as `body.models`
# on every OpenRouter request, so when the primary upstream is
# overloaded / errored, OpenRouter tries the fallbacks in order without
# re-sending. Defaults are sensible cross-vendor (Claude ↔ GPT) — edit
# the file to match what your account has access to.
#
# The base URL is fixed in config/providers.json (it's not env-overridable)
# because OpenRouter's endpoint is hosted; there's no self-host story.
OPENROUTER_API_KEY=

# Optional. Base URL for the backend API surface. Empty (default) means
# same-origin: the Next.js routes under app/api/* serve everything.
# Setting this to e.g. "https://api.example.com" makes lib/api-client.ts
# point at that host instead — used when the backend is rewritten in
# another language (see docs/PLAN-backend-extraction.md). NEXT_PUBLIC_*
# because the value is read in the browser.
NEXT_PUBLIC_API_BASE_URL=

# Optional. Base URL of the Python agent service (services/agent-py/).
# Phase 4-2 of PLAN-agent-api.md — when set, the account menu shows a
# "Python agent backend" toggle that routes chat turns at
# `${NEXT_PUBLIC_AGENT_PY_URL}/v1/chat`. Empty (default) → the toggle
# is hidden and chat always uses the Next.js route. Per project policy
# both stacks stay live indefinitely; this is the user-facing selector,
# not a cutover. Example: `http://localhost:8000` in dev — then also set
# CORS_ALLOWED_ORIGINS=http://localhost:3000 for agent-py (cross-origin).
# Same origin: set it to `/` when a reverse proxy serves agent-py on the
# frontend's own origin (PLAN-frontend-backend-split.md Q21) — requests
# go to `/v1/...` on the current origin and CSP needs no extra source.
# Local dev: `docker compose up proxy agent-py`, then open
# http://localhost:8080 (see README "Same-origin backend").
# When set, the CSP's report-uri / Reporting-Endpoints point at agent-py's
# `/v1/csp-report` (`/` → same-origin `/v1/csp-report`) instead of
# `/api/csp-report`.
NEXT_PUBLIC_AGENT_PY_URL=

# Optional. Base URL of the TypeScript agent service (services/agent-ts/).
# Phase 5 of PLAN-agent-ts.md — same selector wire as the Python
# service. When NEXT_PUBLIC_AGENT_PY_URL is also set, the account
# menu surfaces a 3-way segmented picker (Next.js / TS service /
# Python); otherwise it falls back to a single Switch. Empty
# (default) → no toggle, chat uses the Next.js route. Example:
# `http://localhost:8001` in dev. `/` (same origin) works here too.
NEXT_PUBLIC_AGENT_TS_URL=
# Code interpreter sandbox (optional). Set CODE_SANDBOX_ENABLED=1 to register
# the `runCode` skill and execute model-written Python/JS in a local
# microsandbox microVM (libkrun; HVF on Apple Silicon). Network is OFF inside
# the sandbox; pandas/numpy/matplotlib available (see image note below).
# Absent → the skill is simply not registered (no mock). CODE_SANDBOX_BASE_URL
# also enables it and is reserved for a future remote backend (the local
# microVM runtime ignores the URL). See docs/PLAN-execution-sandbox.md +
# docs/PLAN-code-interpreter.md.
CODE_SANDBOX_ENABLED=
CODE_SANDBOX_BASE_URL=
CODE_SANDBOX_API_KEY=
# Optional overrides: CODE_SANDBOX_TIMEOUT_MS (30000), CODE_SANDBOX_STDOUT_CAP
# (256000), CODE_SANDBOX_RESULT_CAP (10000000), CODE_SANDBOX_RESULT_FILE_MAX (20),
# CODE_SANDBOX_MEM_MIB (512),
# CODE_SANDBOX_CPUS (1), CODE_SANDBOX_MAX_CONCURRENT (2). The Python image must
# already contain the scientific
# stack (airgapped → no pip at run time); the default jupyter/scipy-notebook is
# large — build docker/runcode-python.Dockerfile (~550 MB), push it, and set
# CODE_SANDBOX_PYTHON_IMAGE to that image to trim it (and CODE_SANDBOX_JS_IMAGE,
# default "node", for JavaScript).

# Vision document extraction (optional). Picks the vision-capable model
# used to transcribe layout-rich / scanned PDFs (render pages → image →
# markdown tables/captions) on top of the text-only pass. Must name a
# model flagged `supportsVision` in config/models.json. Unset → the first
# `supportsVision` model in the registry is used; if none is flagged, the
# vision pass is skipped entirely (text-only extraction). See
# docs/PLAN-multimodal-docs.md. Example: `anthropic/claude-sonnet-4.6`.
VISION_MODEL=

# Content-Security-Policy mode (optional). `proxy.ts` mints a per-request
# nonce and emits a strict nonce + 'strict-dynamic' policy (built by
# lib/server/security/csp.ts); violations are POSTed to /api/csp-report
# and logged as `{"evt":"csp_violation",…}` lines.
#   report-only (default) → Content-Security-Policy-Report-Only: nothing is
#                           blocked, violations are only reported
#   enforce               → Content-Security-Policy: violations are blocked
#   off                   → no CSP header at all (other security headers stay)
# Unset or unrecognised → report-only. Read docs/SECURITY.md before
# flipping to `enforce` (live-artifact / MCP-app frames inherit the policy).
CSP_MODE=
