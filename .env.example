# Model registry and provider routing live in:
#   - config/models.json    (which models exist; safe for client bundling)
#   - config/providers.json (how to talk to each provider; server-only,
#                            supports inline `apiKey` / `baseURL` overrides
#                            so users can paste credentials directly there
#                            instead of using these env vars if preferred)
# Each provider entry in providers.json can reference an env var by name
# (`apiKeyEnv`, `baseURLEnv`) — the vars listed below are the ones the
# default config references. Three provider `type`s are supported:
#
#   - "gateway"   → Vercel AI Gateway (apiKey only)
#   - "anthropic" → any Anthropic-compatible endpoint (baseURL + apiKey)
#   - "openai"    → any OpenAI-compatible endpoint (baseURL + apiKey),
#                   works with OpenRouter / Together / Groq / vLLM /
#                   LM Studio / Ollama / self-hosted gateways
#
# Adding a new model is a two-file edit (provider entry + model entry);
# see config/providers.json and lib/server/providers-config.ts for the
# full schema.

# AI Gateway (Vercel) — referenced by the `gateway` provider in
# config/providers.json. Required for real chat & editor AI on the
# default model set. When unset, the chat panel falls back to a clearly
# labeled mock response.
AI_GATEWAY_API_KEY=

# Minimax-CN — referenced by the `minimax-cn` provider in
# config/providers.json. Optional. When BOTH vars are set, the
# `minimax/*` model entries in config/models.json route via the native
# Anthropic provider (Minimax-CN's Anthropic-compatible API) instead of
# going through the Vercel AI Gateway. Either var unset → minimax/*
# falls back to the gateway as declared by the model's `routes` list.
#
# IMPORTANT: include the `/v1` suffix in the base URL. The Anthropic SDK
# appends `/messages` only — it doesn't add `/v1`. So set this to the
# endpoint that, when `/messages` is appended, matches Minimax-CN's
# Anthropic-compatible POST endpoint.
# Example: MINIMAX_CN_BASE_URL=https://api.minimax.chat/anthropic/v1
MINIMAX_CN_BASE_URL=
MINIMAX_CN_API_KEY=

# Supabase — optional. When set, users can sign in (magic link) and sync
# workspaces, conversations, files, and conversation assets across devices.
# When unset, the app runs anonymously on localStorage only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-side only. Required for share links so the
# public `/share/...` pages can read the shared conversation/document via
# the admin client (bypasses RLS, scoped to the token-matched row only).
# Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Tavily — optional. Backs the "Web search (Tavily)" skill. When unset,
# the skill toggle still appears in the UI but the chat route omits the
# tool and tells the model so it falls back to its training data instead
# of inventing a search call.
TAVILY_API_KEY=

# Brave Search — optional. Backs the "Web search (Brave)" skill. Same
# fallback behaviour as Tavily when unset. Independent web index — tends
# to surface fresher, less SEO-spammed results. Get a key from
# https://api-dashboard.search.brave.com (a "Data for Search" plan is
# enough for chat usage). Both providers can be enabled at the same time;
# the model picks whichever it prefers per query and the shared per-turn
# cap (configurable in the right rail) applies across both.
BRAVE_SEARCH_API_KEY=

# Exa — optional. Backs the "Web search (Exa)" provider. Exa runs an
# embedding-based ("neural") web index that tends to surface higher-
# quality, link-target-style pages than keyword engines, plus an "auto"
# mode that picks neural vs keyword per query. Same fallback behaviour
# as Tavily/Brave when unset. Get a key from https://dashboard.exa.ai.
# All three providers can be enabled at once; results are deduped by
# URL and interleaved server-side, and one `webSearch` tool call counts
# as one cap unit regardless of how many providers it fans out to.
EXA_API_KEY=

# Image generation — optional. When the same MINIMAX_CN_API_KEY above
# is set, the chat route exposes a `generateImage` tool that calls
# Minimax's documented `/v1/image_generation` endpoint
# (https://api.minimax.io/v1/image_generation). Supports text-to-image
# and image-to-image (when the model includes a `referenceImageUrl`).
# Each call costs ~1–3¢ depending on aspect ratio + count, so the
# per-IP rate limit below defaults tight. Raise for trusted deployments
# behind auth; lower if you're seeing abuse.
MINIMAX_IMAGE_RATE_LIMIT_PER_MINUTE=5

# MCP encryption — required when any user picks Cloud-mode credentials
# for an MCP server. Generate with `openssl rand -base64 32`. The key
# lives only in the Next.js server env, never in Postgres; it's passed
# as an argument to the SECURITY DEFINER decrypt RPC at request time.
# Rotating invalidates existing cloud-mode creds — users have to re-add
# the server. Leaving unset disables cloud mode (Local mode still works).
MCP_ENCRYPTION_KEY=

# Optional. Base URL for the backend API surface. Empty (default) means
# same-origin: the Next.js routes under app/api/* serve everything.
# Setting this to e.g. "https://api.example.com" makes lib/api-client.ts
# point at that host instead — used when the backend is rewritten in
# another language (see docs/PLAN-backend-extraction.md). NEXT_PUBLIC_*
# because the value is read in the browser.
NEXT_PUBLIC_API_BASE_URL=
