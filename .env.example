# Model registry and provider routing live in:
#   - config/models.json    (which models exist; safe for client bundling)
#   - config/providers.json (how to talk to each provider; server-only,
#                            supports inline `apiKey` / `baseURL` overrides
#                            so users can paste credentials directly there
#                            instead of using these env vars if preferred)
# Each provider entry in providers.json can reference an env var by name
# (`apiKeyEnv`, `baseURLEnv`) — the vars listed below are the ones the
# default config references. Three provider `type`s are supported:
#
#   - "gateway"   → Vercel AI Gateway (apiKey only)
#   - "anthropic" → any Anthropic-compatible endpoint (baseURL + apiKey)
#   - "openai"    → any OpenAI-compatible endpoint (baseURL + apiKey),
#                   works with OpenRouter / Together / Groq / vLLM /
#                   LM Studio / Ollama / self-hosted gateways
#
# Adding a new model is a two-file edit (provider entry + model entry);
# see config/providers.json and lib/server/providers-config.ts for the
# full schema.

# AI Gateway (Vercel) — referenced by the `gateway` provider in
# config/providers.json. Required for real chat & editor AI on the
# default model set. When unset, the chat panel falls back to a clearly
# labeled mock response.
AI_GATEWAY_API_KEY=

# Minimax-CN — referenced by the `minimax-cn` provider in
# config/providers.json. Optional. When BOTH vars are set, the
# `minimax/*` model entries in config/models.json route via the native
# Anthropic provider (Minimax-CN's Anthropic-compatible API) instead of
# going through the Vercel AI Gateway. Either var unset → minimax/*
# falls back to the gateway as declared by the model's `routes` list.
#
# IMPORTANT: include the `/v1` suffix in the base URL. The Anthropic SDK
# appends `/messages` only — it doesn't add `/v1`. So set this to the
# endpoint that, when `/messages` is appended, matches Minimax-CN's
# Anthropic-compatible POST endpoint.
# Example: MINIMAX_CN_BASE_URL=https://api.minimax.chat/anthropic/v1
#
# Both vars are ALSO read by the Python agent service (services/agent-py/)
# from Phase 3d-1+ to enable the `generateImage` tool (Minimax T2I / I2I
# via `/v1/image_generation`, derived from MINIMAX_CN_BASE_URL's origin).
# Empty MINIMAX_CN_API_KEY → the tool is omitted from the registry.
MINIMAX_CN_BASE_URL=
MINIMAX_CN_API_KEY=

# Supabase — optional. When set, users can sign in (magic link) and sync
# workspaces, conversations, files, and conversation assets across devices.
# When unset, the app runs anonymously on localStorage only.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-side only. Required for share links so the
# public `/share/...` pages can read the shared conversation/document via
# the admin client (bypasses RLS, scoped to the token-matched row only).
# ALSO read by the Python agent service from Phase 3d-2+ for the
# `generateImage` Storage-persistence path: when SUPABASE_URL +
# SUPABASE_SERVICE_ROLE_KEY are both set, generated images get mirrored
# into `user-files/<user_id>/generated/...` and the model receives a
# long-lived signed URL instead of the short-lived Minimax URL. Without
# them the tool falls back to inline Minimax URLs (work for hours, then
# expire). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# JWT secret — server-side only. Required by the Python agent service
# (services/agent-py/) for any auth-protected endpoint; without it those
# endpoints return 503. Find it under Project Settings → API → JWT Settings
# in the Supabase dashboard. The Next.js side doesn't use this directly
# (it reads the Supabase session cookie); only the Python service does.
SUPABASE_JWT_SECRET=

# Direct Postgres connection string — server-side only. Required by the
# Python agent service's Phase 1+ poll loop (services/agent-py/poller.py)
# which needs `FOR UPDATE SKIP LOCKED` semantics that the transaction
# pooler doesn't expose. Use the *direct* connection from Supabase's
# dashboard (the one ending in `db.<project>.supabase.co:5432`), NOT the
# pooler (`*.pooler.supabase.com:6543`). Empty in dev → poller no-ops
# every tick (the service still serves /healthz + /readyz).
SUPABASE_DB_URL=

# Anthropic API key — read by the Python agent service (Phase 2b-1+).
# When set, the executor uses the real `messages.stream` against
# Anthropic for any `start` job on a flagged user. Empty → the
# executor falls back to the Phase 2a stub step fn (two canned tokens),
# so the service stays runnable in dev without a live key. The Next.js
# side talks to Anthropic via the Vercel AI Gateway today and doesn't
# read this directly.
ANTHROPIC_API_KEY=

# Optional Anthropic base-URL override. Empty → SDK default
# (https://api.anthropic.com). Set to point the Python service's
# `AsyncAnthropic` client at any Anthropic-compatible endpoint:
#   - a proxy or self-hosted gateway,
#   - a region-specific upstream (Minimax's `/anthropic/v1` host, etc.),
#   - a local model serving the Anthropic messages API.
# Mirrors the TS side's `MINIMAX_CN_BASE_URL` override pattern. Has no
# effect when `ANTHROPIC_API_KEY` is empty (the stub doesn't network).
ANTHROPIC_BASE_URL=

# Tavily — optional. Backs the "Web search (Tavily)" skill on the
# Next.js chat route AND the Python agent service's `webSearch` tool
# (Phase 3c of PLAN-agent-api). When unset:
#   - Next.js side: the skill toggle still appears in the UI but the
#     chat route omits the tool and tells the model so it falls back
#     to training data instead of inventing a search call.
#   - Python service: the `webSearch` tool is omitted entirely from
#     `default_tool_registry()`, so the model never sees it.
TAVILY_API_KEY=

# Brave Search — optional. Backs the "Web search (Brave)" skill. Same
# fallback behaviour as Tavily when unset. Independent web index — tends
# to surface fresher, less SEO-spammed results. Get a key from
# https://api-dashboard.search.brave.com (a "Data for Search" plan is
# enough for chat usage). Both providers can be enabled at the same time;
# the model picks whichever it prefers per query and the shared per-turn
# cap (configurable in the right rail) applies across both.
BRAVE_SEARCH_API_KEY=

# Exa — optional. Backs the "Web search (Exa)" provider. Exa runs an
# embedding-based ("neural") web index that tends to surface higher-
# quality, link-target-style pages than keyword engines, plus an "auto"
# mode that picks neural vs keyword per query. Same fallback behaviour
# as Tavily/Brave when unset. Get a key from https://dashboard.exa.ai.
# All three providers can be enabled at once; results are deduped by
# URL and interleaved server-side, and one `webSearch` tool call counts
# as one cap unit regardless of how many providers it fans out to.
EXA_API_KEY=

# Image generation — optional. When MINIMAX_CN_API_KEY above is set,
# the chat route exposes a `generateImage` tool that calls Minimax's
# documented `/v1/image_generation` endpoint. The endpoint host is
# derived from MINIMAX_CN_BASE_URL's origin (image and chat share a
# host on Minimax — chat lives at `/anthropic/v1/messages`, image at
# `/v1/image_generation`). When MINIMAX_CN_BASE_URL is unset, the
# client falls back to the default `https://api.minimaxi.com`
# endpoint. Supports text-to-image and image-to-image (when the model
# includes a `referenceImageUrl`). Each call costs ~1–3¢ depending on
# aspect ratio + count, so the per-IP rate limit below defaults tight.
# Raise for trusted deployments behind auth; lower if you're seeing
# abuse.
MINIMAX_IMAGE_RATE_LIMIT_PER_MINUTE=5

# MCP encryption — required when any user picks Cloud-mode credentials
# for an MCP server. Generate with `openssl rand -base64 32`. The key
# lives only in the Next.js server env (AND the Python agent service env
# from Phase 3f-1+, which reads the same var to call the same SECURITY
# DEFINER decrypt RPC), never in Postgres; it's passed as an argument
# to the RPC at request time. Rotating invalidates existing cloud-mode
# creds — users have to re-add the server. Leaving unset disables cloud
# mode on both stacks (Local mode still works).
MCP_ENCRYPTION_KEY=

# Optional. Base URL for the backend API surface. Empty (default) means
# same-origin: the Next.js routes under app/api/* serve everything.
# Setting this to e.g. "https://api.example.com" makes lib/api-client.ts
# point at that host instead — used when the backend is rewritten in
# another language (see docs/PLAN-backend-extraction.md). NEXT_PUBLIC_*
# because the value is read in the browser.
NEXT_PUBLIC_API_BASE_URL=

# Optional. Base URL of the Python agent service (services/agent-py/).
# Phase 4-2 of PLAN-agent-api.md — when set, the account menu shows a
# "Python agent backend" toggle that routes chat turns at
# `${NEXT_PUBLIC_AGENT_PY_URL}/v1/chat`. Empty (default) → the toggle
# is hidden and chat always uses the Next.js route. Per project policy
# both stacks stay live indefinitely; this is the user-facing selector,
# not a cutover. Example: `http://localhost:8000` in dev.
NEXT_PUBLIC_AGENT_PY_URL=

# Optional. Base URL of the TypeScript agent service (services/agent-ts/).
# Phase 5 of PLAN-agent-ts.md — same selector wire as the Python
# service. When NEXT_PUBLIC_AGENT_PY_URL is also set, the account
# menu surfaces a 3-way segmented picker (Next.js / TS service /
# Python); otherwise it falls back to a single Switch. Empty
# (default) → no toggle, chat uses the Next.js route. Example:
# `http://localhost:8001` in dev.
NEXT_PUBLIC_AGENT_TS_URL=

# Optional. Soft retirement lever for the in-Next agent worker (the
# `processNextJob` bootstrap on /api/tasks + the /api/tasks/jobs/tick
# cron). Defaults to `true` so vanilla deploys without a dedicated
# agent service keep working. Set to `false` once agent-py or
# agent-ts is running — the dedicated service then owns the queue
# claim path and the Next.js process no longer races it. Follow-up
# #4 in docs/PLAN-agent-ts-followups.md.
INLINE_AGENT_WORKER=
