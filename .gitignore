# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
# `next dev` writes agent rules here on every start (next.config `agentRules`).
/AGENTS.md
/apps/web/AGENTS.md
/.next/
/out/
/apps/web/out/

# production
/build
/apps/web/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.next
.claude

.documents

# Supabase CLI — generated state (the .branches/ .temp/ dirs and the
# auto-managed seed.sql cache). config.toml is intentionally tracked.
supabase/.branches/
supabase/.temp/
supabase/seed.sql

# Bun is the package manager — keep other lockfiles out
package-lock.json
yarn.lock
pnpm-lock.yaml

# Playwright e2e (apps/web/playwright.config.ts, e2e-live/): Next build dirs + outputs
.next-e2e/
.next-e2e-wire/
test-results/
playwright-report/
blob-report/
playwright/.cache/
