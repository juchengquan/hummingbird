{
  "name": "hummingbird",
  "private": true,
  "packageManager": "bun@1.3.9",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun --cwd=apps/web run dev",
    "build": "bun --cwd=apps/web run build",
    "start": "bun --cwd=apps/web run start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit -p tsconfig.json && bun --cwd=apps/web run typecheck",
    "test": "bash scripts/run-tests.sh",
    "test:e2e": "bun --cwd=apps/web run test:e2e",
    "test:e2e:wire": "bun --cwd=apps/web run test:e2e:wire",
    "test:e2e:live": "bash e2e-live/stack.sh bash -c 'bunx playwright test -c e2e-live/playwright.config.ts && \"$LIVE_PY\" -B e2e-live/routes.py'",
    "test:e2e:smoke": "LIVE_ANTHROPIC_URL= bash e2e-live/stack.sh bash -c '\"$LIVE_PY\" -B e2e-live/smoke.py'",
    "check": "bun run typecheck && bun run lint && bun run check:migrations && bun run test",
    "check:migrations": "bun scripts/check-migration-versions.ts",
    "check:ci": "bun run typecheck && bun run lint && bun run check:migrations && bun run test && bun run build && bun run audit:bundle",
    "audit:bundle": "bun --cwd=apps/web run audit:bundle",
    "check:next-env": "bun --cwd=apps/web run check:next-env",
    "env:split": "bun scripts/env-split.ts",
    "docs:user-manual:build": "bun scripts/list-user-features.ts && bun scripts/build-user-manual-toc.ts",
    "docs:user-manual:check": "bun scripts/list-user-features.ts --check && bun scripts/build-user-manual-toc.ts --check",
    "docs:user-manual:roundtrip": "bun test scripts/__tests__/inventory-roundtrip.test.ts",
    "contract:gen": "bash packages/contract/scripts/gen.sh",
    "contract:check": "bun packages/contract/scripts/lint.ts && bash packages/contract/scripts/gen.sh --check",
    "contract:lint": "bun packages/contract/scripts/lint.ts",
    "contract:conformance": "bun test ./packages/contract/conformance",
    "codegen:agent-types": "bash scripts/codegen-agent-types.sh",
    "codegen:agent-types:check": "bash scripts/codegen-agent-types.sh --check",
    "test:db": "bash scripts/test-db.sh",
    "check:agent-py": "cd services/agent-py && uv run ruff check . && uv run ruff format --check . && uv run mypy src && uv run pytest",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:reset": "supabase db reset",
    "supabase:status": "supabase status",
    "supabase:types": "supabase gen types typescript --local > apps/web/lib/shared/supabase/types.ts",
    "supabase:docker:up": "docker compose -f docker-compose.supabase.yml up -d",
    "supabase:docker:down": "docker compose -f docker-compose.supabase.yml down",
    "supabase:docker:reset": "docker compose -f docker-compose.supabase.yml down -v && docker compose -f docker-compose.supabase.yml up -d && sleep 8 && bash .docker/supabase/apply-migrations.sh",
    "supabase:docker:migrate": "bash .docker/supabase/apply-migrations.sh",
    "fixtures:runs": "bash scripts/record-runs-fixtures.sh"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@redocly/openapi-core": "^1.34.15",
    "@types/bun": "^1.3.14",
    "@types/node": "^20",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "openapi-typescript": "^7.9.1",
    "typescript": "^5"
  },
  "overrides": {
    "undici": "^6.29.1"
  },
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
