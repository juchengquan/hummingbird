    "lint": "eslint src tests",
    "test": "bun test --conditions=react-server"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^2.0.79",
    "ai": "^5.0.28",
    "hono": "^4.6.0",
    "jose": "^5.10.0",
    "postgres": "^3.4.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.1.0",
    "typescript": "^5.6.0"
  }
}
