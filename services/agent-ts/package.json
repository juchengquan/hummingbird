{
  "name": "agent-ts",
  "version": "0.1.0",
  "description": "Hummingbird agent service — TypeScript implementation (twin of services/agent-py).",
  "module": "src/server.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --conditions=react-server --watch src/server.ts",
